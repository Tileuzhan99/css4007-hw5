# Copy to .env and fill in. Part 1 does not need a model or API key:
#   python run_scenarios.py --part 1
#
# Parts 2 and 3 need one tool-capable model. Set MODEL_PROVIDER to pick the
# adapter, or leave it blank and whichever key is present is used (Anthropic
# first). MODEL_NAME is optional; each provider has a default.
#
#   MODEL_PROVIDER=anthropic    -> default MODEL_NAME=claude-opus-5-5
#   MODEL_PROVIDER=openai       -> default MODEL_NAME=gpt-5.6-luna
#   MODEL_PROVIDER=google_genai -> default MODEL_NAME=gemini-3.5-flash
MODEL_PROVIDER=
MODEL_NAME=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Where conversation checkpoints, user memory and ticket drafts are written.
# Kept out of git; delete it (or run `python app.py --reset-memory`) to start again.
HELPDESK_STORAGE_DIR=local-storage

# Keep external tracing disabled for this local exercise.
LANGSMITH_TRACING=false
